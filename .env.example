# Discord user token (discord.py-self)
DISCORD_TOKEN=

# DonutNova session cookie(s). Use DONUTNOVA_COOKIE with | separated values, or DONUTNOVA_COOKIES.
# Example: DONUTNOVA_COOKIE=donutchip_session=...|donutchip_session=...
DONUTNOVA_COOKIE=

# Optional: DonutNova API token (if used instead of cookies)
# DONUTNOVA_TOKEN=

# Withdrawal recipient username on DonutNova
DONUTNOVA_WITHDRAW_RECIPIENT=ignCocktail
